# --- Web (Next.js) ---
# Öffentliche API-Basis-URL zur CAD-API (nur nicht-geheime Werte via NEXT_PUBLIC_*)
NEXT_PUBLIC_CAD_API_URL=http://localhost:6294
PORT=6293

# Server-seitige Session-Secrets (NIE als NEXT_PUBLIC_* setzen)
SESSION_SECRET=change-me-to-a-long-random-value
CSRF_SECRET=change-me-to-a-different-long-random-value

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=slotcrate
MYSQL_USER=slotcrate
MYSQL_PASSWORD=change-me

# Prisma
DATABASE_URL="mysql://slotcrate:change-me@localhost:3306/slotcrate"

# --- CAD-API (FastAPI) ---
CAD_API_HOST=0.0.0.0
CAD_API_PORT=6294
# Interner Shared-Secret-Token für Web ↔ CAD-API. Nicht ins Frontend geben.
CAD_API_INTERNAL_TOKEN=change-me

# Rate-Limits (Requests pro Minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_BOX_STL=30
RATE_LIMIT_LAYOUT_ZIP=10
RATE_LIMIT_PLATE_STL=15
RATE_LIMIT_LAYOUT_SHARE=10

# Ablaufzeit für geteilte Layout-Kurz-URLs (in Tagen, Max. 365)
SHARE_LAYOUT_TTL_DAYS=90

# Admin-Bootstrap (nur beim erstmaligen Setup verwenden, danach löschen)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
